# Google service account with edit access to the target Sheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key from the service account JSON. Keep the \n escape sequences as-is;
# the app converts them to real newlines at runtime.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# The ID of the Google Sheet (from its URL) with "Complaints" and "Owners" tabs
GOOGLE_SHEET_ID=

# Claude API key, used server-side only for the AI Insights Report
ANTHROPIC_API_KEY=

# Shared admin password (plain string, compared server-side)
ADMIN_PASSWORD=

# Random long string used to sign session cookies (owner + admin)
SESSION_SECRET=
